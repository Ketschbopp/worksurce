<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>TN_RadioReceiver</defName>
		<label>radio receiver</label>
		<description>A powered listening post for intercepting public broadcasts, trader chatter, and distant faction traffic. A colonist assigned to research work can monitor it to improve report speed and reliability.</description>
		<thingClass>TheNews.Building_RadioReceiver</thingClass>
		<graphicData>
			<texPath>Things/Building/RadioReceiver</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shadowData>
				<volume>(0.55, 0.30, 0.40)</volume>
			</shadowData>
			<damageData>
				<rectN>(0.078125,0.46875,0.859375,0.53125)</rectN>
				<rectS>(0.078125,0.46875,0.859375,0.53125)</rectS>
				<rectE>(0.125,0.46875,0.625,0.296875)</rectE>
				<rectW>(0.25,0.46875,0.625,0.296875)</rectW>
				<cornerTR>Damage/Corner</cornerTR>
			</damageData>
		</graphicData>
		<defaultPlacingRot>South</defaultPlacingRot>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.2</fillPercent>
		<pathCost>20</pathCost>
		<statBases>
			<MaxHitPoints>110</MaxHitPoints>
			<WorkToBuild>4800</WorkToBuild>
			<Mass>15</Mass>
			<Flammability>0.7</Flammability>
			<Beauty>1</Beauty>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<building>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
		</building>
		<designationCategory>Misc</designationCategory>
		<uiOrder>2110</uiOrder>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>80</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>TN_RadioMonitoring</li>
		</researchPrerequisites>
		<placeWorkers>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<uiIconScale>0.85</uiIconScale>
