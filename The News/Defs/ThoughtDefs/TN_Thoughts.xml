  <!-- v1.3 Homeland Ties: a colonist hears confirmed catastrophe (war/plague/coup/famine/disaster) striking
       the faction they hail from. Dread-for-kin: large, slow-decaying, and can stack as the homeland suffers. -->
  <ThoughtDef>
    <defName>TN_HomelandGrief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>dread for my homeland</label>
        <description>The news from home is grim. My people are suffering and there is nothing I can do but listen.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- v1.3 Homeland Ties: bad news about the homeland turned out to be wrong - relief that the worst was a false report. -->
  <ThoughtDef>
    <defName>TN_HomelandRelief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>homeland spared</label>
        <description>The frightening report about home was wrong after all. I can breathe again.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

