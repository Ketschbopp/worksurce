<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- v1.01 Famous Colonists: a colonist whose heroic deeds reached the wider world feels the glow of renown.
       Lasts ~2 weeks (a full quadrum is 15 days) so the moment of fame lingers. -->
  <ThoughtDef>
    <defName>TN_ColonistCelebrity</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>14</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>TN_Thought_Celebrity_Label</label>
        <description>TN_Thought_Celebrity_Desc</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

