    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>troubled by the rumor</label>
        <description>They say something terrible is happening out there. I can't shake the feeling that it's true.</description>
