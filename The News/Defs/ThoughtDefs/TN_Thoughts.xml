  <ThoughtDef>
    <defName>TN_RumorSkeptic</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>unmoved by the rumor</label>
        <description>People will believe anything they hear on the radio. I'll wait for something I can actually trust.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- v1.3 The Long Dread: low-grade unease while a major foreign crisis drags on, unresolved, in the feed. -->
  <ThoughtDef>
    <defName>TN_LongDread</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>shadow of a distant crisis</label>
        <description>The trouble out there just keeps grinding on. Every bulletin sits a little heavier than the last.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- v1.3 The Long Dread: the prolonged crisis the colony had been following finally resolves - the long wait is over. -->
  <ThoughtDef>
    <defName>TN_DreadLifted</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a crisis finally ends</label>
        <description>That long, grinding trouble out there is over at last. The whole colony seems to exhale.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- v1.3 Refugees: those taken in as temporary lodgers (the "take as guests" path) feel relief and
       gratitude at finding shelter, food, and work after fleeing a crisis. Fades over their stay. -->
  <ThoughtDef>
    <defName>TN_RefugeeFoundRefuge</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>found refuge</label>
        <description>After everything we ran from, these people took us in - a roof, food, and honest work. It is more than I let myself hope for.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

