  <!-- War escalation (open conflict confirmed nearby) -->
  <ThoughtDef>
    <defName>TN_WarEscalatesNearby</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>7</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>war erupts nearby</label>
        <description>Open conflict has broken out between factions near our colony. We may feel the effects.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Famine nearby -->
