<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 导弹生成的专用反粒子地雷，不可拆卸，无造价 -->
  <ThingDef ParentName="TrapIEDBase">
    <defName>IRBM_TrapIED_Antigrain_NonRemovable</defName>
    <label>IED antigrain warhead trap</label>
    <description>An antigrain mine distributed by a tactical missile. It is optimized for rapid field deployment and its internal triggers are too volatile to allow for safe dismantling or relocation.</description>
    <graphicData>
      <texPath>Things/Building/Security/IEDAntigrainWarhead</texPath>
    </graphicData>
    <uiOrder>2000</uiOrder>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>14.9</explosiveRadius>
        <explosiveDamageType>BombSuper</explosiveDamageType>
        <startWickHitPointsPercent>0.8</startWickHitPointsPercent>
        <chanceToStartFire>0.22</chanceToStartFire>
        <damageFalloff>true</damageFalloff>
        <explosionEffect>GiantExplosion</explosionEffect>
        <explosionSound>Explosion_GiantBomb</explosionSound>
        <wickTicks>15</wickTicks>
        <startWickOnDamageTaken>
          <li>Bullet</li>
          <li>Arrow</li>
          <li>ArrowHighVelocity</li>
        </startWickOnDamageTaken>
        <preExplosionSpawnSingleThingDef>CraterMedium</preExplosionSpawnSingleThingDef>
      </li>
    </comps>
    <minifiedDef Inherit="False" /> 
    <designationCategory Inherit="False" />
    <researchPrerequisites Inherit="False" />
    <specialDisplayRadius>14.9</specialDisplayRadius>
    <building>
      <claimable>false</claimable> <!-- 导弹地雷不可被占领 -->
      <deconstructible>false</deconstructible>
    </building>
    <thingCategories Inherit="False" />
  </ThingDef>

</Defs>
