<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>IRBM_UnknownSignalFacility</defName>
    <label>unknown signal</label>
    <description>A mysterious frequency emanating from an untraceable source. Conventional research equipment cannot decipher this data stream.</description>
    <graphicData>
      <texPath>MissileWarhead/IRBM_Warhead_Strategic_GammaRay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>60</Mass>
    </statBases>
    <!-- 不分配 designationCategory，使其在建造列表中不可见 -->
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.1</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
  </ThingDef>
  
</Defs>
