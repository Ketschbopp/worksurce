<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 洲际导弹发射井 -->
  <ThingDef ParentName="BuildingBase">
    <defName>IRBM_MissileSilo</defName>
    <label>ICBM missile silo</label>
    <description>A reinforced underground silo for assembling and launching intercontinental ballistic missiles.</description>
    <thingClass>IRBM.Building_MissileSilo</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/IRBM_MissileSilo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
      <shadowData>
        <volume>(4.6, 0.6, 4.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>5000</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <size>(5,5)</size>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <costList>
      <Steel>300</Steel>
      <Plasteel>50</Plasteel>
      <Uranium>20</Uranium>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="IRBM.CompProperties_MissileAssembler" />
    </comps>
    <modExtensions>
      <li Class="IRBM.SiloExtension">
        <silos>
          <li>
            <size>3</size>
            <offset>(0,0)</offset>
            <coverTexPath>Things/Building/IRBM_SiloCover</coverTexPath>
            <coverZoom>0.8</coverZoom>
            <coverOffset>(0,-0.8)</coverOffset>
            <coverMovementTicks>60</coverMovementTicks>
          </li>
        </silos>
      </li>
    </modExtensions>
    <designationCategory>IRBM</designationCategory>
    <uiOrder>2000</uiOrder>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>IRBM_AdvancedAerospace</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- 基础导弹发射井 -->
  <ThingDef ParentName="BuildingBase">
    <defName>IRBM_MissileSilo_Medium</defName>
    <label>basic missile silo</label>
