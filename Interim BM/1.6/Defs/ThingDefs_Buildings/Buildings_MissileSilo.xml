      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.8, 0.6, 2.8)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>2500</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <size>(3,3)</size>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="IRBM.CompProperties_MissileAssembler" />
    </comps>
    <modExtensions>
      <li Class="IRBM.SiloExtension">
        <silos>
          <li>
            <size>2</size>
            <offset>(0,0)</offset>
            <coverTexPath>Things/Building/IRBM_SiloCover</coverTexPath>
            <coverZoom>0.8</coverZoom>
            <coverOffset>(0,-0.8)</coverOffset>
            <coverMovementTicks>60</coverMovementTicks>
          </li>
        </silos>
      </li>
    </modExtensions>
    <designationCategory>IRBM</designationCategory>
    <uiOrder>2001</uiOrder>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>IRBM_BasicRocketry</li>
    </researchPrerequisites>
  </ThingDef>

