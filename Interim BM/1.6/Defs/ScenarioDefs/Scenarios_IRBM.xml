<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenarioDef>
    <defName>IRBM_PostNuclearWar</defName>
    <label>Post-Nuclear War</label>
    <description>The world as you knew it ended in a flash of blinding light. Decades of tension finally snapped, and the silos opened. You are among the few who survived in deep underground bunkers, preserved by the very missile technology that destroyed the surface. Now, as the initial firestorms subside into a freezing nuclear winter, it is time to resurface and reclaim the wasteland.</description>
    <scenario>
      <summary>Three survivors from a strategic missile command center. Starts with advanced technology and a decade-long nuclear winter.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <surfaceLayer>
        <def>PlanetLayerFixed</def>
        <layer>Surface</layer>
        <settingsDef>Surface</settingsDef>
        <hide>true</hide>
        <tag>Surface</tag>
      </surfaceLayer>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>

        <!-- Player arrival -->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <!-- Custom IRBM Post-Nuclear War Logic (Sets Alert status) -->
        <li Class="IRBM.ScenPart_IRBM_PostNuclearWar">
          <def>IRBM_PostNuclearWarLogic</def>
        </li>

        <!-- Start with Research -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>AdvancedFabrication</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_BasicRocketry</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_EarlyWarheads</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_EarlyDelivery</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_EarlyWarning</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_AdvancedAerospace</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_OrbitalRecon</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_NuclearDeterrence</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>IRBM_KineticInterception</project>
        </li>

        <!-- Player starting things (Standard) -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>1200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>80</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>40</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>800</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>500</count>
        </li>

        <!-- Bonus Resources -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentSpacer</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gold</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Plasteel</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined" MayRequire="Ludeon.RimWorld.Biotech">
          <def>StartingThing_Defined</def>
          <thingDef>Apparel_GasMask</thingDef>
          <count>3</count>
        </li>

        <!-- Standard weapons -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_BoltActionRifle</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_Revolver</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Plasteel</stuff>
        </li>

        <!-- Standard pets -->
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>1</count>
          <bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
        </li>

        <!-- Scattered items -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>450</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>IRBM_PostNuclearWar_Dialog</textKey>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <!-- Def for the custom ScenPart -->
  <ScenPartDef>
    <defName>IRBM_PostNuclearWarLogic</defName>
    <label>Post-nuclear war initialization</label>
    <scenPartClass>IRBM.ScenPart_IRBM_PostNuclearWar</scenPartClass>
    <category>Fixed</category>
    <selectionWeight>0</selectionWeight> <!-- Not selectable in editor, only for this scenario -->
  </ScenPartDef>

</Defs>
